# Intervals.icu Authentication
# Create an API key in Intervals.icu -> Settings -> API Access
INTERVALS_API_KEY=your_api_key_here

# Athlete ID (defaults to "0" which refers to the authenticated user account)
INTERVALS_ATHLETE_ID=0

# Intervals.icu API Base URL (defaults to https://intervals.icu/api/v1)
INTERVALS_BASE_URL=https://intervals.icu/api/v1

# Tool routing — semantic search to show only relevant tools
# TOOL_ROUTING=true

# ContextForge Gateway (runs the server via mcp-contextforge-gateway on port 8000)
# ENABLE_CONTEXTFORGE_GATEWAY=true
